# The hostname the certificate is issued for. Caddy needs a name, not an IP.
#
# If you do not own a domain, sslip.io resolves any name containing an IP to that
# IP, and Let's Encrypt issues for it:
#   DOMAIN=barnraise.203.0.113.42.sslip.io
DOMAIN=demo.example.org

# How often the ledger goes back to its demo state, in seconds.
RESET_SECONDS=900

# The loopback port the host web server proxies to (behind-proxy compose only).
APP_PORT=8320
