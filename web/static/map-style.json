{
  "version": 8,
  "name": "Barnraise neighborhood",
  "metadata": {
    "note": "Written against the OpenMapTiles vector schema rather than restyling a hosted theme, so every colour here is a token from web/static/styles.css. A styled Google or Carto map always reads as a styled Google or Carto map; this reads as the product.",
    "tiles": "OpenFreeMap, free and keyless, OpenStreetMap data under ODbL"
  },
  "glyphs": "https://tiles.openfreemap.org/fonts/{fontstack}/{range}.pbf",
  "sources": {
    "omt": {
      "type": "vector",
      "url": "https://tiles.openfreemap.org/planet",
      "attribution": "<a href=\"https://openfreemap.org\">OpenFreeMap</a> \u00b7 <a href=\"https://www.openstreetmap.org/copyright\">OpenStreetMap</a>"
    }
  },
  "layers": [
    {
      "id": "ground",
      "type": "background",
      "paint": {
        "background-color": "#091421"
      }
    },
    {
      "id": "park",
      "type": "fill",
      "source": "omt",
      "source-layer": "park",
      "paint": {
        "fill-color": "#10241f",
        "fill-opacity": 0.9
      }
    },
    {
      "id": "landuse-built",
      "type": "fill",
      "source": "omt",
      "source-layer": "landuse",
      "filter": [
        "in",
        "class",
        "residential",
        "commercial",
        "industrial",
        "school",
        "hospital"
      ],
      "paint": {
        "fill-color": "#0d1926",
        "fill-opacity": 0.8
      }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "omt",
      "source-layer": "water",
      "paint": {
        "fill-color": "#0b2036"
      }
    },
    {
      "id": "building",
      "type": "fill",
      "source": "omt",
      "source-layer": "building",
      "minzoom": 13.5,
      "paint": {
        "fill-color": "#141f2d",
        "fill-opacity": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          13.5,
          0.35,
          16,
          0.75
        ],
        "fill-outline-color": "#1b2736"
      }
    },
    {
      "id": "road-minor",
      "type": "line",
      "source": "omt",
      "source-layer": "transportation",
      "filter": [
        "in",
        "class",
        "minor",
        "service",
        "track",
        "path"
      ],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#26364b",
        "line-width": [
          "interpolate",
          [
            "exponential",
            1.4
          ],
          [
            "zoom"
          ],
          12,
          0.6,
          15,
          2.2,
          17,
          6,
          19,
          14
        ]
      }
    },
    {
      "id": "road-major",
      "type": "line",
      "source": "omt",
      "source-layer": "transportation",
      "filter": [
        "in",
        "class",
        "primary",
        "secondary",
        "tertiary",
        "trunk",
        "motorway"
      ],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#3b4f6b",
        "line-width": [
          "interpolate",
          [
            "exponential",
            1.4
          ],
          [
            "zoom"
          ],
          12,
          1.4,
          15,
          4.5,
          17,
          11,
          19,
          26
        ]
      }
    },
    {
      "id": "rail",
      "type": "line",
      "source": "omt",
      "source-layer": "transportation",
      "filter": [
        "==",
        "class",
        "rail"
      ],
      "paint": {
        "line-color": "#18222f",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          13,
          0.5,
          18,
          3
        ],
        "line-dasharray": [
          3,
          2
        ]
      }
    },
    {
      "id": "road-label",
      "type": "symbol",
      "source": "omt",
      "source-layer": "transportation_name",
      "minzoom": 14.2,
      "layout": {
        "text-field": [
          "get",
          "name"
        ],
        "text-font": [
          "Noto Sans Regular"
        ],
        "text-size": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          14.5,
          9,
          18,
          12
        ],
        "symbol-placement": "line",
        "text-letter-spacing": 0.06
      },
      "paint": {
        "text-color": "#7a8798",
        "text-halo-color": "#091421",
        "text-halo-width": 1.4
      }
    },
    {
      "id": "place-label",
      "type": "symbol",
      "source": "omt",
      "source-layer": "place",
      "filter": [
        "in",
        "class",
        "neighbourhood",
        "suburb"
      ],
      "layout": {
        "text-field": [
          "get",
          "name"
        ],
        "text-font": [
          "Noto Sans Regular"
        ],
        "text-size": 13,
        "text-letter-spacing": 0.18,
        "text-transform": "uppercase"
      },
      "paint": {
        "text-color": "#6d7a88",
        "text-halo-color": "#091421",
        "text-halo-width": 1.6
      }
    }
  ]
}
